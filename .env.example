# Template only -- copy to .env for LOCAL use. On Render, set these in the dashboard.
# Never commit a real .env.

APP_NAME=JETSI_APP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
LOG_CHANNEL=single
LOG_LEVEL=debug
APP_LOG=errorlog
APP_LOG_LEVEL=error

# Local XAMPP database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jetsi_local
DB_USERNAME=jetsi_local
DB_PASSWORD=
# For Supabase, change this to require.
DB_SSLMODE=prefer

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=null
QUEUE_DRIVER=sync
QUEUE_CONNECTION=sync

# Mail (SMTP)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
#MAIL_FROM_ADDRESS=
#MAIL_FROM_NAME=

# Google sign-in (Socialite). Redirect URI to register: ${APP_URL}/auth/google/verify
GOOGLE_OAUTH_ID=
GOOGLE_OAUTH_SECRET=

# Paystack
PAYSTACK_PUBLIC=
PAYSTACK_SECRET=

# Container behaviour (docker/start.sh)
RUN_MIGRATIONS=false
CACHE_CONFIG=true
BACKPACK_REGISTRATION_OPEN=false
