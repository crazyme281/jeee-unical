

RewriteEngine on

RewriteCond %{HTTP_HOST} ^localhost/journal-app$ [NC,OR]

RewriteCond %{HTTP_HOST} ^localhost/journal-app$

RewriteCond %{REQUEST_URI} !public/

RewriteRule (.*) /public/$1 [L]

